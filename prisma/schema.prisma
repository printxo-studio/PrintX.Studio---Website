datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String?
  role         String    @default("OWNER")
  avatar       String?
  phone        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Customer {
  id           String    @id @default(cuid())
  customerCode String    @unique
  name         String
  company      String?
  customerType String    @default("B2C")
  phone        String?
  email        String?   @unique
  passwordHash String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  country      String    @default("India")
  gstin        String?
  source       String?   @default("Website Storefront")
  rating       Float     @default(5.0)
  status       String    @default("ACTIVE")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders       Order[]
  invoices     Invoice[]
  payments     Payment[]
  leads        Lead[]
}

model Lead {
  id              String    @id @default(cuid())
  leadCode        String    @unique
  name            String
  company         String?
  phone           String?
  email           String?
  source          String    @default("WEBSITE")
  requirement     String?
  budget          Float?
  productInterest String?
  status          String    @default("NEW")
  priority        String    @default("MEDIUM")
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Product {
  id                     String           @id @default(cuid())
  sku                    String           @unique
  name                   String
  category               String?
  productType            String           @default("STANDARD")
  description            String?
  status                 String           @default("ACTIVE")
  currentVersion         String           @default("1.0")
  isPublished            Boolean          @default(true)
  stockQuantity          Int              @default(50)
  slug                   String?          @unique
  imageUrl               String?
  images                 Json?
  colorOptions           Json?
  dimensions             String?

  materialName           String?
  recommendedPrinter     String?
  nozzleSize             Float            @default(0.4)
  layerHeight            Float            @default(0.2)
  infillPercent          Int              @default(20)
  wallCount              Int              @default(3)
  supportRequired        Boolean          @default(false)
  standardPrintTimeHours Float            @default(0)
  standardFilamentGrams  Float            @default(0)

  sellingPrice           Float            @default(0)
  productionCost         Float            @default(0)
  estimatedMargin        Float            @default(0)

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  versions               ProductVersion[]
  orderItems             OrderItem[]
  reviews                Review[]
}

model ProductVersion {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version    String
  revision   Int      @default(1)
  changeLog  String?
  stlFileUrl String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id])
  quoteId          String?
  orderDate        DateTime    @default(now())
  dueDate          DateTime?
  priority         String      @default("NORMAL")
  
  subtotal         Float       @default(0)
  discountTotal    Float       @default(0)
  taxAmount        Float       @default(0)
  shippingCost     Float       @default(0)
  totalAmount      Float       @default(0)
  
  paymentStatus    String      @default("PENDING")
  productionStatus String      @default("PENDING")
  qcStatus         String      @default("PENDING")
  shippingStatus   String      @default("PENDING")
  overallStatus    String      @default("CONFIRMED")
  
  shippingAddress  String?
  shippingMethod   String?     @default("Standard Surface")
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items            OrderItem[]
  invoices         Invoice[]
  shipments        Shipment[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  name        String
  sku         String?
  description String?
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  taxRate     Float    @default(18.0)
  lineTotal   Float    @default(0)
}

model Shipment {
  id               String    @id @default(cuid())
  shipmentCode     String    @unique
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id])
  courierName      String
  trackingNumber   String?
  trackingUrl      String?
  shipDate         DateTime?
  expectedDelivery DateTime?
  deliveredDate    DateTime?
  shippingCost     Float     @default(0)
  status           String    @default("PENDING")
  delayReason      String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id])
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  billingAddress  String?
  shippingAddress String?
  gstin           String?
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime
  paymentTerms    String?       @default("Due on Receipt")
  
  subtotal        Float         @default(0)
  discountTotal   Float         @default(0)
  taxableAmount   Float         @default(0)
  cgstAmount      Float         @default(0)
  sgstAmount      Float         @default(0)
  igstAmount      Float         @default(0)
  shippingAmount  Float         @default(0)
  grandTotal      Float         @default(0)
  amountPaid      Float         @default(0)
  balanceDue      Float         @default(0)
  
  status          String        @default("DRAFT")
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]
  payments        Payment[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnSacCode  String?  @default("8477")
  quantity    Int      @default(1)
  rate        Float    @default(0)
  discount    Float    @default(0)
  taxRate     Float    @default(18.0)
  amount      Float    @default(0)
}

model Payment {
  id              String   @id @default(cuid())
  paymentCode     String   @unique
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  amount          Float
  paymentDate     DateTime @default(now())
  paymentMethod   String   @default("UPI")
  referenceNumber String?
  status          String   @default("CONFIRMED")
  notes           String?
  createdAt       DateTime @default(now())
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  type          String    @default("PERCENTAGE")
  value         Float
  minOrderValue Float?    @default(0)
  maxDiscount   Float?
  usageLimit    Int?
  timesUsed     Int       @default(0)
  validFrom     DateTime  @default(now())
  validTo       DateTime?
  isActive      Boolean   @default(true)
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating       Int      @default(5)
  reviewerName String
  comment      String?
  source       String   @default("WEBSITE")
  feedbackType String?  @default("GENERAL")
  createdAt    DateTime @default(now())

  @@index([productId])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  description String?
  updatedAt   DateTime @updatedAt
}

