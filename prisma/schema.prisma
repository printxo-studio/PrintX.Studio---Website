datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  IN_PRODUCTION
  QUALITY_CHECK
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CustomRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTE_SENT
  APPROVED
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  REJECTED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// 1. Authentication & Users
model User {
  id            String               @id @default(cuid())
  name          String?
  email         String               @unique
  passwordHash  String
  role          Role                 @default(CUSTOMER)
  phone         String?
  avatar        String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  addresses     Address[]
  orders        Order[]
  cart          Cart?
  wishlist      WishlistItem[]
  customRequests CustomPrintRequest[]
  messages      CustomPrintMessage[]
  activityLogs  AdminActivityLog[]
  reviews       Review[]
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault   Boolean  @default(false)
  fullName    String
  phone       String
  street      String
  city        String
  state       String
  postalCode  String
  country     String   @default("IN")
  createdAt   DateTime @default(now())

  orders      Order[]
}

// 2. Catalog & Products
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  sku                String         @unique
  shortDescription   String
  fullDescription    String
  price              Float          // Base price in INR
  salePrice          Float?
  costPrice          Float?
  stockQuantity      Int            @default(0)
  lowStockThreshold  Int            @default(5)
  material           String         // PLA+, PETG, Resin, ABS, Carbon Fiber
  colorOptions       String[]       @default([])
  dimensions         String?        // e.g. "120 x 85 x 150 mm"
  productionTimeDays Int            @default(2)
  isFeatured         Boolean        @default(false)
  isActive           Boolean        @default(true)
  metaTitle          String?
  metaDescription    String?
  categoryId         String
  category           Category       @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]
  reviews            Review[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
}

// 3. Cart & Wishlist
model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int      @default(1)
  selectedColor String?
  notes         String?
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// 4. Orders & Payments
model Order {
  id                String              @id @default(cuid())
  orderNumber       String              @unique
  userId            String?
  user              User?               @relation(fields: [userId], references: [id])
  customerEmail     String
  customerPhone     String?
  status            OrderStatus         @default(PENDING_PAYMENT)
  subtotal          Float
  taxAmount         Float               @default(0)
  shippingAmount    Float               @default(0)
  discountAmount    Float               @default(0)
  totalAmount       Float
  currency          String              @default("INR")
  shippingAddressId String?
  shippingAddress   Address?            @relation(fields: [shippingAddressId], references: [id])
  shippingDetails   Json?
  internalNotes     String?

  items             OrderItem[]
  payment           Payment?
  shipment          Shipment?
  customRequestId   String?             @unique
  customRequest     CustomPrintRequest? @relation(fields: [customRequestId], references: [id])

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  title         String
  sku           String?
  price         Float
  quantity      Int
  selectedColor String?
  customDetails Json?
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String        @default("STRIPE")
  transactionId   String?       @unique
  paymentIntentId String?       @unique
  amount          Float
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber String?
  carrier        String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?
}

// 5. Custom 3D Print Request & Quoting Engine
model CustomPrintRequest {
  id                String              @id @default(cuid())
  requestNumber     String              @unique
  userId            String?
  user              User?               @relation(fields: [userId], references: [id])
  guestEmail        String?
  guestName         String?
  guestPhone        String?
  projectTitle      String
  description       String
  intendedUse       String?
  quantity          Int                 @default(1)
  dimensions        String?
  preferredMaterial String              @default("PLA")
  preferredColor    String?
  finish            String?             @default("Raw")
  targetBudget      Float?
  deadline          DateTime?
  shippingAddress   Json?
  internalNotes     String?
  status            CustomRequestStatus @default(SUBMITTED)

  files             CustomPrintFile[]
  quote             CustomPrintQuote?
  messages          CustomPrintMessage[]
  order             Order?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model CustomPrintFile {
  id                 String             @id @default(cuid())
  requestId          String
  request            CustomPrintRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  filename           String
  fileUrl            String
  fileSize           Int
  fileType           String
  estimatedVolumeCm3 Float?
  boundingBox        Json?
  createdAt          DateTime           @default(now())
}

model CustomPrintQuote {
  id                 String             @id @default(cuid())
  requestId          String             @unique
  request            CustomPrintRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  unitPrice          Float
  quantity           Int
  materialCost       Float?
  laborCost          Float?
  shippingCost       Float              @default(0)
  totalAmount        Float
  productionTimeDays Int                @default(3)
  validUntil         DateTime
  adminMessage       String?
  status             QuoteStatus        @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model CustomPrintMessage {
  id          String             @id @default(cuid())
  requestId   String
  request     CustomPrintRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?              @relation(fields: [senderId], references: [id])
  senderRole  Role
  senderName  String
  message     String
  attachments Json?
  createdAt   DateTime           @default(now())
}

// 6. Coupons & Discounts
model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  type          DiscountType @default(PERCENTAGE)
  value         Float
  minOrderValue Float?       @default(0)
  maxDiscount   Float?
  usageLimit    Int?
  timesUsed     Int          @default(0)
  validFrom     DateTime     @default(now())
  validTo       DateTime?
  isActive      Boolean      @default(true)
}

// 7. Site Settings & Operational Models
model SiteSettings {
  id                    String   @id @default("singleton")
  storeName             String   @default("PrintXO Studio")
  contactEmail          String   @default("support@printxo.com")
  contactPhone          String   @default("+91 98765 43210")
  address               String   @default("PrintXO Studio, Tech Maker Hub, India")
  currencySymbol        String   @default("₹")
  currencyCode          String   @default("INR")
  taxRatePercent        Float    @default(18.0)
  shippingFlatRate      Float    @default(149.0)
  freeShippingThreshold Float    @default(1499.0)
  announcementBanner    String?
  enableStripe          Boolean  @default(true)
  featuredCategoryIds   String[] @default([])
  updatedAt             DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  rating     Int      @default(5)
  title      String?
  comment    String
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model AdminActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}
