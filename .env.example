# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="printxo_studio_super_secret_jwt_key_2026_at_least_32_chars_long"

# Database Connection (Supabase PostgreSQL Shared Pooler)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# PrintX - BOS Shared Integration
BOS_API_SECRET="your-internal-bos-api-secret"
NEXT_PUBLIC_BOS_URL="http://localhost:3001"

# Stripe Payments (Optional in development - mock mode available if empty)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# File Upload Storage Provider ("local" | "cloudinary" | "s3")
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Transactional Email Provider ("console" | "resend")
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="PrintXO Studio <support@printxo.com>"

# Default Currency & Localization
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_CURRENCY_CODE="INR"
